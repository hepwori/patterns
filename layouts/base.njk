<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {%- set fullTitle = site.title if page.url == '/' else title + ' — ' + site.title %}
  {%- set desc = description or site.description %}
  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ desc }}" />
  <link rel="canonical" href="{{ site.origin }}{{ page.url }}" />
  <meta property="og:type" content="{{ 'website' if page.url == '/' else 'article' }}" />
  <meta property="og:site_name" content="{{ site.title_short }}" />
  <meta property="og:title" content="{{ fullTitle }}" />
  <meta property="og:description" content="{{ desc }}" />
  <meta property="og:url" content="{{ site.origin }}{{ page.url }}" />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
  <noscript><style>#menu-toggle{display:none}#sidebar{position:static;transform:none;width:auto;height:auto}#sidebar-nav{height:auto}#nav-search{display:none}</style></noscript>
</head>
<body>

  <div id="layout">

    <div id="sidebar-backdrop"></div>

    <nav id="sidebar">
      <div id="sidebar-header">
        <a href="/" id="site-title">
          <span class="title-main">{{ site.title_short }}</span>
        </a>
        <input type="search" id="nav-search" placeholder="Search patterns…" aria-label="Search patterns" />
      </div>

      <div id="sidebar-nav">
        <ul class="nav-top">
          <li><a href="/" class="nav-link nav-contents{% if page.url == '/' %} active{% endif %}">Home</a></li>
          {%- for pg in site.pages %}
          <li><a href="/{{ pg.slug }}/" class="nav-link{% if page.url == '/' + pg.slug + '/' %} active{% endif %}">{{ pg.title }}</a></li>
          {%- endfor %}
        </ul>

        <div id="nav-categories">
          {%- for cat in site.categories %}
          <div class="nav-category" data-category-id="{{ cat.id }}">
            <span class="nav-category-title">{{ cat.title }}</span>
            <ul>
              {%- for p in cat.patterns %}
              <li><a href="/{{ p.slug }}/" class="nav-link{% if page.url == '/' + p.slug + '/' %} active{% endif %}" data-slug="{{ p.slug }}" data-summary="{{ p.summary }}">{{ p.title }}</a></li>
              {%- endfor %}
            </ul>
          </div>
          {%- endfor %}
        </div>
      </div>
    </nav>

    <button id="menu-toggle" aria-label="Toggle navigation">&#9776;</button>

    <main id="content">
      <article id="page">
{{ content | safe }}
      </article>
    </main>

  </div>

  <script src="/nav.js" defer></script>
</body>
</html>
